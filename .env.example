# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Maps ----
# Browser key: restrict to your domains, enable Maps JavaScript API + Places API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key: restrict by IP, enable Distance Matrix API + Geocoding API
GOOGLE_MAPS_SERVER_KEY=

# ---- Higgsfield media pipeline ----
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp
HIGGSFIELD_API_KEY=
HIGGSFIELD_WEBHOOK_SECRET=

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CARTEL_DEFAULT_BRANCH_SLUG=cartel-hq

# ---- Vercel AI Gateway (AI SDK v7 ToolLoopAgent) ----
AI_GATEWAY_API_KEY=

# ---- WhatsApp Business Cloud API (automatic order notices to the branch) ----
# Leave blank to use only the one-tap WhatsApp button on the order confirmation.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with 5 body variables: order no, member, fulfilment, items, total.
# Without a template, WhatsApp only delivers if the branch messaged the sender in the last 24h.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
